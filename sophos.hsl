function sophos_av($fp, $opts = [])
{
	$path = $opts["path"] ?? "/var/run/sssp.sock";
	$address = $opts["address"] ?? "127.0.0.1";
	$port = $opts["port"] ?? 0;
	$timeout = $opts["timeout"] ?? 5;
	$rfc822 = $opts["rfc822"] ?? true;

	$socket = Socket($port ? Socket::AF($address) : "AF_UNIX", "SOCK_STREAM");
	$socket->settimeout($timeout);
	if (!$socket->connect(...($port ? [$address, $port] : [$path])))
		return ["error" => "connect error"];

	$response = "";
	while (($resp = $socket->recv(1)) and $resp[0] != "\n")
		$response .= $resp;

	if (str_strip($response) != "OK SSSP/1.0")
		return ["error" => "protocol error"];

	$length = $fp->seek(0, "SEEK_END");
	$fp->seek(0, "SEEK_SET");

	$container = "Content-Type: message/rfc822\r\n\r\n";
	if ($rfc822)
		$length += length($container);

	if (!$socket->send("SSSP/1.0 SCANDATA $length\n"))
		return ["error" => "send error"];

	if ($rfc822)
		if (!$socket->send($container))
			return ["error" => "send error"];

	while ($str = $fp->read(8192))
		if (!$socket->send($str))
			return ["error" => "send error"];

	$result = [];
	while (true)
	{
		$response = "";
		while (($resp = $socket->recv(1)) and $resp[0] != "\n")
			$response .= $resp;
		if (!$response or $resp[0] != "\n")
			return ["error" => "recv error"];

		$d = pcre_match(#/^VIRUS ([^ ]+) .*$/, $response);
		if ($d)
		{
			$result["virus"][] = $d[1];
			continue;
		}

		$d = pcre_match(#/^SANDBOX.*$/, $response);
		if ($d)
		{
			$result["sandbox"] = true;
			continue;
		}

		$d = pcre_match(#/^DLP CCL (.*)$/, $response);
		if ($d)
		{
			[$name, $location] = str_split(str_strip($d[1]), " ");
			$result["dlp"]["ccl"][]["name"] = url_decode($name);
			if ($location)
				$result["dlp"]["ccl"][length($result["dlp"]["ccl"]) - 1]["location"] = url_decode($location);
			continue;
		}
		$d = pcre_match(#/^DLP MATCHES (\d+) TRIGGERED (True|False) SCORE (\d+)/, $response);
		if ($d)
		{
			$result["dlp"]["ccl"][length($result["dlp"]["ccl"]) - 1]["matches"] = number($d[1]);
			$result["dlp"]["ccl"][length($result["dlp"]["ccl"]) - 1]["triggered"] = $d[2] == "True";
			$result["dlp"]["ccl"][length($result["dlp"]["ccl"]) - 1]["score"] = number($d[3]);
			continue;
		}
		$d = pcre_match(#/^DLP MATCH (\d+)/, $response);
		if ($d)
		{
			$result["dlp"]["ccl"][length($result["dlp"]["ccl"]) - 1]["match"][] = [];
			continue;
		}
		$d = pcre_match(#/^DLP MATCH(TEXT|PREFIX|SUFFIX) (.*)/, $response);
		if ($d)
		{
			$result["dlp"]["ccl"][length($result["dlp"]["ccl"]) - 1]["match"][
				length($result["dlp"]["ccl"][length($result["dlp"]["ccl"]) - 1]["match"]) - 1
			][str_lower($d[1])] = url_decode(str_strip($d[2]));
			continue;
		}

		$d = pcre_match(#/^TFT TYPE (.*)$/, $response);
		if ($d)
		{
			$result["tft"]["types"][] = url_decode(str_strip($d[1]));
			continue;
		}

		$d = pcre_match(#/^DONE (FAIL|OK) ([^ ]+) (.*)$/, $response);
		if ($d)
		{
			if ($d[1] == "FAIL")
				$result["error"] = $d[2];
			break;
		}
	}

	if ($socket->send("BYE\n"))
	{
		while (($resp = $socket->recv(1)) and $resp[0] != "\n")
			continue;
	}

	return $result;
}

function sophos_as($fp, $opts = [])
{
	$address = $opts["address"] ?? "127.0.0.1";
	$port = $opts["port"] ?? 25315;
	$timeout = $opts["timeout"] ?? 5;
	$has_bec = isset($opts["bec"]);

	$length = $fp->seek(0, "SEEK_END");
	$fp->seek(0, "SEEK_SET");

	$bec = "";
	if ($has_bec) {
		$bec = json_encode([
		    "schema_version" => 1,
		    "models" => [
			[
			    "name" => "email-spam",
			    "score" => 50,
			    "score_object" => [
				"spam" => $opts["bec"]["spam"]["score"],
				"bulk" => $opts["bec"]["bulk"]["score"],
				"threat" => $opts["bec"]["threat"]["score"]
			    ]
			]
		    ]
		]).";";
		if ($bec === none)
			return ["error" => "Unable to encode BEC context"];
		$length += length($bec);
	}

	$result = http("http://".$address.":".$port,
				[
					"timeout" => $timeout,
					"extended_result" => true,
					"post_size" => $length,
					"headers" => [
						"Transfer-Encoding: ",
						"X-LASED-Pver: 0000002",
						"X-LASED-ReqType: message",
						"X-LASED-MessageContext: ".($has_bec ? "True" : "False"),
						"Content-Type: application/octet-stream",
						"Connection: close",
						"Content-Length: " .$length,
					]
				], [], function ($size) closure ($bec, $fp) {
					if ($bec !== "") {
						$chunk = $bec[0:$size];
						$bec = $bec[$size:];
						return $chunk;
					}
					return $fp->read($size);
				}
			);

	if ($result["status"] != 200)
		return ["error" => $result["content"] ?: "http-error " . $result["status"]];

	return array_reduce(function($carry, $x) {
			return [...$carry, str_replace("X-LASED-", "", $x[0]) => match($x[0]) {
				"X-LASED-Impersonation" => $x[1] == "True",
				"X-LASED-SpamProbability" => number($x[1]),
				"X-LASED-Hits" => array_reduce(function($carry, $x) {
							return [...$carry, $x[0] => number($x[1])];
						},
						array_map(function ($str) {
							return str_split($str, " ", 2);
						}, str_split($x[1], ", ")), []),
				"X-LASED-Version" => array_reduce(function($carry, $x) {
							return [...$carry, $x[0] => $x[1]];
						},
						array_map(function ($str) {
							return str_split($str, ": ", 2);
						}, str_split($x[1], ", ")), []),
				default => $x[1]
			}];
		}, array_map(function ($str) {
			return str_split($str, ": ", 2);
		}, str_split(str_strip($result["content"]), "\r\n")), []);
}

function sophos_bec($fp, $opts = [])
{
	$address = $opts["address"] ?? "127.0.0.1";
	$port = $opts["port"] ?? 8080;
	$timeout = $opts["timeout"] ?? 5;

    $filename = "scanme";
    $boundary = uuid();
    $preamble = array_join([
        "--".$boundary,
        "Content-Disposition: form-data; name=\"file\"; filename=\"".$filename."\"",
        "Content-Type: application/octet-stream",
    ], "\r\n")."\r\n\r\n";
    $postamble = "\r\n--".$boundary."--\r\n";
    $data = [$preamble, $fp, $postamble];
    $response = http("http://".$address.":".$port."/v1/analysis", [
            "timeout" => $timeout,
            "extended_result" => true,
            "headers" => [
                "Content-type: multipart/form-data; boundary=" . $boundary
            ]
        ], [], function ($size) closure ($data) {
            while (length($data)) {
                if (is_string($data[0])) {
                    $x = $data[0][0:$size];
                    $data[0] = $data[0][$size:];
                } else {
                    $x = $data[0]->read($size);
                }
                if ($x !== "")
                    return $x;
                $data = $data[1:];
            }
            return "";
        }
    );

    if (!$response) return ["error" => "non empty response"];
    if ($response["status"] != 200) return ["error" => "non 200 response"];

    return json_decode($response["content"]);
}